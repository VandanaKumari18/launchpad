# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Groq — console.groq.com/keys (every AI step, including tool calling)
GROQ_API_KEY=

# Resend — resend.com/api-keys (weekly brief email, free tier)
RESEND_API_KEY=

# Adzuna — developer.adzuna.com (job listings, free tier)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Any random string — protects /api/cron/weekly-agent from being called
# by anyone who finds the URL. Set the same value in Vercel's Cron
# settings (Authorization: Bearer <value>) once deployed.
CRON_SECRET=
